<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Since_Last_Contact__c</fullName>
    <description>Number of days since Last_Contact_Date__c. Blank when no qualifying Customer Contact has been recorded yet.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Last_Contact_Date__c), null, FLOOR(NOW() - Last_Contact_Date__c))</formula>
    <label>Days Since Last Contact</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
